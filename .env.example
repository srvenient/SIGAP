# ==========================================
# Configuración General del Entorno
# ==========================================

# Entorno de ejecución de la aplicación (ej: development, production)
ENVIRONMENT=local

# Tipo de dispositivo para procesamiento (ej: cpu, cu130)
DEVICE_TYPE=cpu

# Habilita o deshabilita el modo de depuración (true o false)
DEBUG=true

# Nivel de detalle de los registros/logs (ej: debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# Información del Proyecto
# ==========================================

# Nombre del proyecto
PROJECT_NAME=sigap

# Versión actual del proyecto
PROJECT_VERSION=0.0.1

# ==========================================
# Configuración de la API
# ==========================================

# Clave secreta para la firma de tokens JWT (Cambiar por una segura en tu .env local)
SECRET_KEY=tu_clave_secreta_aqui

# URL base del frontend (útil para configurar CORS, redirecciones, etc.)
FRONTEND_URL=http://localhost:3000

# Nombre de usuario del primer superusuario (Cambiar por un nombre seguro en tu .env local)
FIRST_SUPERUSER=admin

# Contraseña del primer superusuario (Cambiar por una contraseña segura en tu .env local)
FIRST_SUPERUSER_PASSWORD=admin123

# ==========================================
# Worker de cámaras y talanqueras
# ==========================================

# Clave con la que el worker se autentica ante la API (mínimo 16 caracteres, obligatoria)
# Se puede generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=cambia_esta_clave_de_dispositivo

# Puerto y velocidad del Arduino
ARDUINO_PORT=COM3
ARDUINO_BAUD=9600

# Índices de las cámaras en el equipo donde corre el worker
CAM_ENTRY_INDEX=1
CAM_EXIT_INDEX=2

# ==========================================
# Pasarela de pago
# ==========================================

# Solo está implementada la pasarela simulada, que no cobra dinero real
PAYMENT_GATEWAY=simulated

# Segundos que espera la confirmación de la pasarela antes de dar el intento por vencido
PAYMENT_TIMEOUT_SECONDS=180

# ==========================================
# Configuración de la Base de Datos (PostgreSQL)
# ==========================================

# Nombre de usuario de la base de datos PostgreSQL
POSTGRES_USER=postgres

# Contraseña del usuario de PostgreSQL (Cambiar por una segura en tu .env local)
POSTGRES_PASSWORD=tu_contraseña_aqui

# Dirección del servidor de la base de datos (ej: localhost, db, etc.)
POSTGRES_SERVER=db

# Puerto de conexión a PostgreSQL (por defecto es 5432)
POSTGRES_PORT=5432

# Nombre de la base de datos a utilizar para el proyecto
POSTGRES_DB=sigap_db